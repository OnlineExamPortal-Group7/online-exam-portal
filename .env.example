# Development uses config.settings.dev and needs none of these.
# Production (config.settings.prod) REQUIRES every variable marked (required);
# startup fails with a clear error if one is missing or blank.
DJANGO_SETTINGS_MODULE=config.settings.prod

# (required) long random string
DJANGO_SECRET_KEY=
# (required) comma-separated, e.g. exams.example.edu,www.example.edu
DJANGO_ALLOWED_HOSTS=
# (required)
POSTGRES_DB=
POSTGRES_USER=
# (required, must not be empty)
POSTGRES_PASSWORD=
POSTGRES_HOST=
# optional, default 5432
POSTGRES_PORT=5432
